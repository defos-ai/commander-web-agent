schema_version: 1
type: "{{ .Type }}"
version: {{ .Version }}
responsibilities:
{{- range .Responsibilities }}
  - {{ printf "%q" . }}
{{- end }}
actions:
{{- range .Actions }}
  - name: {{ printf "%q" .Name }}
    description: {{ printf "%q" .Description }}
{{- end }}
native:
{{- range .Native }}
  {{ .Platform }}:
    asset: {{ .Asset }}
    sha256: "{{ .SHA256 }}"
{{- end }}
docker:
  image: {{ .DockerImage }}
